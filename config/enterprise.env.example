# Copy to ~/.config/qwen-coder/enterprise.env and fill in. chmod 600. Never commit.
# Loaded only by the MCP wrapper scripts (~/.local/bin/atlassian-mcp, ~/.local/bin/gitlab-mcp);
# tokens never land in ~/.pi/agent/mcp.json.

# ---- Jira / Confluence (Server or Data Center) --------------------------------
# PAT: Jira → 프로필 → Personal Access Tokens, Confluence → 프로필 → Personal Access Tokens
JIRA_URL="https://jira.example.internal"
JIRA_PERSONAL_TOKEN=""
CONFLUENCE_URL="https://confluence.example.internal"
CONFLUENCE_PERSONAL_TOKEN=""

# 사내 자체 서명 인증서면 false, 사내 CA 를 macOS 키체인에 넣었다면 true 유지
JIRA_SSL_VERIFY="true"
CONFLUENCE_SSL_VERIFY="true"

# 처음엔 읽기 전용으로 시작하고 익숙해지면 false 로
READ_ONLY_MODE="true"
# 자주 쓰는 프로젝트/스페이스만 (컨텍스트 절약, 검색 범위 축소). 쉼표 구분, 비우면 전체
JIRA_PROJECTS_FILTER=""
CONFLUENCE_SPACES_FILTER=""
# 노출할 도구만 (40여 개 중). 비우면 전체. 예: jira_search,jira_get_issue,jira_create_issue,jira_add_comment,confluence_search,confluence_get_page,confluence_create_page
ENABLED_TOOLS=""

# ---- GitLab (self-hosted) -------------------------------------------------------
# PAT: GitLab → Preferences → Access Tokens (scope: api 또는 read_api)
GITLAB_API_URL="https://gitlab.example.internal/api/v4"
GITLAB_PERSONAL_ACCESS_TOKEN=""
# readonly | modify | full
GITLAB_PERMISSION_MODE="readonly"
# core 만으로 시작 (projects, MRs, issues, files). 필요 시 ,pipelines,wiki,milestones 추가
GITLAB_TOOLSETS="core"
# 사내 CA 로 서명된 GitLab 이면 PEM 경로 지정 (Node 용). 자체 서명이면 NODE_TLS_REJECT_UNAUTHORIZED=0 (비권장)
NODE_EXTRA_CA_CERTS=""

# ---- 사내 프록시가 있을 때 ------------------------------------------------------
HTTP_PROXY=""
HTTPS_PROXY=""
NO_PROXY="localhost,127.0.0.1,.example.internal"
